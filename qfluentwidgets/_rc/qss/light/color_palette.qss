QLabel#sectionLabel {
    font-weight: bold;
    color: gray;
    padding-top: 8px;
    padding-bottom: 4px;
    padding-left: 10px;
}

ColorPalette {
    background-color: transparent;
}

QPushButton#pickerButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    text-align: left;
    padding-left: 10px;
    padding-right: 10px;
    color: black;
    font: 14px 'Segoe UI', 'Microsoft YaHei';
}

QPushButton#pickerButton:hover {
    background-color: rgba(0, 0, 0, 9);
}

QPushButton#pickerButton:pressed {
    background-color: rgba(0, 0, 0, 6);
}
