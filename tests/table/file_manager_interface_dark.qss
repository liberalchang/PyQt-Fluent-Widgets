#fileManagerInterface {
    background-color: transparent;
}

#pathStatusDot {
    border-radius: 5px;
    background-color: rgba(255, 80, 80, 200);
}

#pathStatusDot[status="ok"] {
    background-color: rgba(0, 220, 120, 200);
}

#pathStatusDot[status="busy"] {
    background-color: rgba(255, 170, 60, 220);
}

#pathSeparator {
    background-color: rgba(255, 255, 255, 35);
}

